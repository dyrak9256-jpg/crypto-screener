TELEGRAM_TOKEN=your_telegram_bot_token_here
# Мульти-ботовый режим (опционально): несколько токенов через запятую —
# подписчики распределяются между ботами (снятие лимитов Telegram на бота).
#TELEGRAM_TOKENS=token_one,token_two
ADMIN_CHAT_IDS=123456789,987654321

DB_USER=screener_user
DB_PASSWORD=change_me
DB_NAME=screener_db
DATABASE_URL=postgres://screener_user:change_me@localhost:5432/screener_db?sslmode=disable

HARD_MIN_SPREAD=0.01

# Taker-комиссии (доля на сторону сделки) вычитаются из спреда до funding-оценки,
# поэтому все сигналы показывают чистый спред. DEFAULT — для всех бирж без
# своего значения. Меняется на лету: /setfees (персистится в БД).
#FEES=DEFAULT:0.0005,BINANCE:0.0004

# HTTP-сервер метрик и статуса: /metrics (Prometheus), /healthz, /api/status
# (JSON), /debug/pprof/ (профилирование Go). Пусто — порт :9090.
#METRICS_ADDR=:9090

# Логи: формат text|json, уровень debug|info|warn|error.
#LOG_FORMAT=text
#LOG_LEVEL=info
