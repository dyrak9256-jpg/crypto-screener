# Скопируйте этот файл в .env и заполните значениями.
# .env находится в .gitignore и не попадает в репозиторий.

# --- База данных ---
DATABASE_URL=postgres://screener_user:screener_password@localhost:5432/screener_db?sslmode=disable

# --- Telegram ---
TELEGRAM_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
# chat_id администраторов (для /addex и /rmex), через запятую.
# Если пусто — административные команды недоступны ни для кого.
ADMIN_CHAT_IDS=

# --- Жёсткие минимальные пороги (guardrails) ---
HARD_MIN_SPREAD=0.01        # 1%
HARD_MIN_VOLUME=1000000     # 1M USDT
